table SalesTable

	measure 'CA Total' = SUM(SalesTable[CA_Net_FCFA])
		formatString: #,##0

	measure 'Marge Brute' = SUM(SalesTable[Marge_Brute_FCFA])
		formatString: #,##0

	measure 'Taux de Marge' = DIVIDE([Marge Brute], [CA Total], 0)
		formatString: 0.0%

	measure 'Nombre de Transactions' = DISTINCTCOUNT(SalesTable[Transaction_ID])
		formatString: #,##0

	measure 'Panier Moyen' = DIVIDE([CA Total], [Nombre de Transactions], 0)
		formatString: #,##0

	measure 'Unités Vendues' = SUM(SalesTable[Quantite])
		formatString: #,##0

	measure 'Clients Actifs' = DISTINCTCOUNT(SalesTable[Customer_ID])
		formatString: #,##0

	measure 'CA Mobile Money' = CALCULATE([CA Total], SalesTable[Mode_Paiement] IN {"MTN MoMo", "Orange Money"})
		formatString: #,##0

	measure 'Part Mobile Money' = DIVIDE([CA Mobile Money], [CA Total], 0)
		formatString: 0.0%

	measure 'CA B2B' = CALCULATE([CA Total], SalesTable[Canal] = "B2B")
		formatString: #,##0

	measure 'Part B2B' = DIVIDE([CA B2B], [CA Total], 0)
		formatString: 0.0%

	measure 'Remise Moyenne' = AVERAGE(SalesTable[Taux_Remise])
		formatString: 0.0%

	column Transaction_ID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Transaction_ID

	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date

	column Annee
		dataType: int64
		summarizeBy: none
		sourceColumn: Annee

	column AnneeMois
		dataType: string
		summarizeBy: none
		sourceColumn: AnneeMois

	column Ville
		dataType: string
		summarizeBy: none
		sourceColumn: Ville

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

	column Customer_ID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Customer_ID

	column Segment_Client
		dataType: string
		summarizeBy: none
		sourceColumn: Segment_Client

	column Product_ID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Product_ID

	column Categorie
		dataType: string
		summarizeBy: none
		sourceColumn: Categorie

	column Produit
		dataType: string
		summarizeBy: none
		sourceColumn: Produit

	column Commercial
		dataType: string
		summarizeBy: none
		sourceColumn: Commercial

	column Canal
		dataType: string
		summarizeBy: none
		sourceColumn: Canal

	column Mode_Paiement
		dataType: string
		summarizeBy: none
		sourceColumn: Mode_Paiement

	column Quantite
		dataType: int64
		summarizeBy: sum
		sourceColumn: Quantite

	column Prix_Unitaire_FCFA
		dataType: int64
		summarizeBy: none
		sourceColumn: Prix_Unitaire_FCFA

	column Taux_Remise
		dataType: double
		summarizeBy: none
		sourceColumn: Taux_Remise

	column CA_Net_FCFA
		dataType: double
		summarizeBy: sum
		sourceColumn: CA_Net_FCFA

	column Marge_Brute_FCFA
		dataType: double
		summarizeBy: sum
		sourceColumn: Marge_Brute_FCFA

	column Taux_Marge
		dataType: double
		summarizeBy: none
		sourceColumn: Taux_Marge

